# For local development with SQLite
DATABASE_URL=sqlite+aiosqlite:///./nxthike.db

# For Docker Compose / PostgreSQL
# DATABASE_URL=postgresql+asyncpg://nxthike:nxthike_secret@db:5432/nxthike

# For production (Neon, etc.)
# DATABASE_URL=postgresql+asyncpg://user:pass@host/nxthike

SECRET_KEY=your-secret-key-change-in-production
ADMIN_EMAIL=admin@nxthike.com
ADMIN_PASSWORD=admin123
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
POSTGRES_PASSWORD=nxthike_secret
