{
  "name": "nxthike-dev",
  "private": true,
  "description": "NxtHike monorepo — FE (Vite) + BE (FastAPI)",
  "scripts": {
    "dev:fe": "npm --prefix FE run dev",
    "build:fe": "npm --prefix FE run build",
    "dev:be": "cd BE && . venv/bin/activate && uvicorn app.main:app --reload --port 8000",
    "seed:hiring": "cd BE && . venv/bin/activate && python -m app.seed_hiring"
  }
}
