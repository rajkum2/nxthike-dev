# --- Database ---
# Local SQLite (default if neither URL is set)
DATABASE_URL=sqlite+aiosqlite:///./nxthike.db

# Supabase — use the **Session pooler** URI (recommended from Railway):
# Supabase Dashboard → Project Settings → Database → Connection string →
#   Method: "Session mode" (port 5432 on *.pooler.supabase.com)
#   OR "Transaction mode" (port 6543) — app sets statement_cache_size=0 automatically
#
# Example (Session pooler — best for long-lived API servers):
# SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# Avoid bare db.YOUR_REF.supabase.co:5432 from Railway if you see IPv6 / connect errors.
# If password has special characters (@ # % etc), URL-encode them.
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Skip alembic on boot (default true) — tables created via SQLAlchemy create_all
SKIP_ALEMBIC=true

# Supabase project metadata (optional)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth — generate strong values, never commit real secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import secrets,string; a=string.ascii_letters+string.digits+'!@%^*-_=+'; print(''.join(secrets.choice(a) for _ in range(28)))"
SECRET_KEY=  # required: 32+ random chars (quoted if needed)
ADMIN_EMAIL=admin@nxthike.com
ADMIN_PASSWORD=  # required: 12+ chars, mixed case + digit + symbol (quote the value)
# Optional: seed weak demo student/employer accounts (default off)
# SEED_DEMO_USERS=false

# CORS — include FE origin(s)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Local uploads fallback
UPLOAD_DIR=./uploads
SEED_DIR=../FE/public/seed

# --- Storage: local | r2 ---
STORAGE_BACKEND=local
MAX_UPLOAD_MB=15

# Cloudflare R2 (when STORAGE_BACKEND=r2)
# Create R2 bucket + API token with Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nxthike-uploads
# Public base URL (R2 custom domain or r2.dev public bucket URL)
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# Optional endpoint override
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
