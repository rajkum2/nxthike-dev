# --- Database ---
# Local SQLite (default if neither URL is set)
DATABASE_URL=sqlite+aiosqlite:///./nxthike.db

# Supabase / production Postgres (preferred when set)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project metadata (optional)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@nxthike.com
ADMIN_PASSWORD=admin123

# CORS — include FE origin(s)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Local uploads fallback
UPLOAD_DIR=./uploads
SEED_DIR=../FE/public/seed

# --- Storage: local | r2 ---
STORAGE_BACKEND=local
MAX_UPLOAD_MB=15

# Cloudflare R2 (when STORAGE_BACKEND=r2)
# Create R2 bucket + API token with Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nxthike-uploads
# Public base URL (R2 custom domain or r2.dev public bucket URL)
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# Optional endpoint override
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
