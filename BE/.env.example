# --- Database ---
# Local SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./nxthike.db

# Supabase Postgres (recommended for production)
# Project Settings → Database → Connection string (URI)
# Use Session mode or Transaction pooler (port 5432 / 6543)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or direct:
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Supabase project (optional metadata / future client use)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@nxthike.com
ADMIN_PASSWORD=admin123

# CORS — include FE origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

UPLOAD_DIR=./uploads
SEED_DIR=../FE/public/seed
