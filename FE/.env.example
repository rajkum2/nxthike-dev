# ─────────────────────────────────────────────────────────────
# NxtHike — Frontend (Vite)
# Copy to `.env` and fill in. Only VITE_* vars reach the browser.
# NOTE: everything here is PUBLIC — it ships inside the JS bundle.
# Never put service-role keys, R2 credentials, or SECRET_KEY here.
# ─────────────────────────────────────────────────────────────

# Where the app reads its data from.
#   json     — static seed arrays in src/data (no backend needed)
#   api      — FastAPI backend (use this for BE-backed data + Hiring CRM)
#   supabase — direct Supabase JS client reads
# Default when unset: json
VITE_DATA_SOURCE=api

# FastAPI base URL. Only used when VITE_DATA_SOURCE=api.
# Must point at the NxtHike BE — :8000 is often taken by another app,
# so this project runs on :8010 locally.
# Default when unset: http://localhost:8000
VITE_API_URL=http://localhost:8010

# Supabase browser credentials — ONLY needed when VITE_DATA_SOURCE=supabase.
# In `api` mode leave these blank: the FE talks to FastAPI, and FastAPI
# reaches Postgres/Supabase itself via BE's DATABASE_URL.
# If missing in supabase mode the app silently falls back to a mock client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Cloudflare R2: nothing to configure here.
# Uploads go FE → POST {VITE_API_URL}/api/uploads/* → BE → R2.
# All R2 credentials live in BE/.env only.
# ─────────────────────────────────────────────────────────────

# Deploying to Netlify? These same VITE_* vars must be set in
# Site settings → Environment variables. netlify.toml only pins
# NODE_VERSION, and a committed .env would otherwise bake in localhost.
