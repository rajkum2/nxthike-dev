# Data source: json | supabase | api
# Use "api" so jobs/hiring load from FastAPI (not static JSON)
VITE_DATA_SOURCE=api

# FastAPI backend — must point at NxtHike BE (not another app on :8000)
# Local: http://localhost:8010  (if :8000 is already used by PHP/other)
VITE_API_URL=http://localhost:8010

# Supabase (optional direct client use when VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
