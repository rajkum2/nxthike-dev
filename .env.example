# Placeholder names only. Copy to an untracked .env and fill values in on the host.
# Do not commit a filled-in copy. This Vite app reads VITE_* from FE/.env
# (see FE/.env.example). The names below were previously committed at the repo
# root; rotate any live value, then keep it out of git.

VITE_DATA_SOURCE=
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy CRA names. This repository does not read REACT_APP_*.
REACT_APP_API_SECURITY_KEY=
PUBLIC_URL=
REACT_APP_API_URL=
REACT_APP_BASE_URL=

# Legacy Next.js names. This repository does not read NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel injects this in its own environment. Never commit a token.
VERCEL_OIDC_TOKEN=
